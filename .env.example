# Required — writes the meditation.
ANTHROPIC_API_KEY=sk-ant-...

# Required — speaks it.
ELEVENLABS_API_KEY=sk_...

# Optional. Signs the ticket that lets /api/speak voice a line. If unset, a stable
# secret is derived from ELEVENLABS_API_KEY, so a fresh fork works without it.
SIGNING_SECRET=

# Optional rate limits, per IP per hour.
SCRIPTS_PER_HOUR=5
LINES_PER_HOUR=120
